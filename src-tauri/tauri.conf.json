{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZNet Sink",
  "version": "0.0.16-rc.8",
  "identifier": "org.zerodenet.znetsink",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "ZNet Sink",
        "width": 900,
        "height": 650,
        "decorations": false,
        "transparent": false,
        "visible": true,
        "resizable": true,
        "shadow": true
      },
      {
        "label": "traffic-ball",
        "title": "ZNet Sink Traffic",
        "url": "/traffic-ball",
        "width": 96,
        "height": 96,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/zerodenet/znet-sink/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI1RTVFRTE5Njc3MDdDQTkKUldTcGZIQm5HZTdsSlZkT282UzZYRUg2Y0Y0L1d1SjBUQVZpZHdJS0w2T1FOank1SDNSbU1aVisK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": "v1Compatible",
    "resources": [
      "resources/builtin-rules/NOTICE.md",
      "resources/builtin-rules/LICENSE.meta-rules-dat"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "bundleVersion": "0.0.16"
    },
    "windows": {
      "wix": {
        "version": "0.0.16"
      },
      "nsis": {
        "installerHooks": "./nsis/uninstall.nsh"
      }
    }
  }
}
