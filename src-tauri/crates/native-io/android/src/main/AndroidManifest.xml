<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <provider
            android:name="org.zerodenet.znetsink.nativeio.NativeIoFileProvider"
            android:authorities="${applicationId}.nativeio.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/native_io_paths" />
        </provider>
        <receiver android:name="org.zerodenet.znetsink.nativeio.ShareSelectionReceiver"
            android:exported="false" />
    </application>
</manifest>
