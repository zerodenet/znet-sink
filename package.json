{
  "name": "znetsink",
  "version": "0.0.16-rc.8",
  "description": "ZNet Sink desktop client for ZeroDenet",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:nodes": "pnpm test:nodes-view-model && pnpm test:nodes-probe-state && pnpm test:nodes-select",
    "test:nodes-view-model": "node --experimental-strip-types --loader ./scripts/lib-alias-loader.mjs scripts/test-nodes-view-model.mjs",
    "test:nodes-select": "node scripts/test-nodes-select-args.mjs",
    "test:notifications": "node --experimental-strip-types --loader ./scripts/lib-alias-loader.mjs scripts/test-notification-logging.mjs",
    "test:diagnostic-copy": "node --experimental-strip-types --loader ./scripts/lib-alias-loader.mjs scripts/test-diagnostic-copy.mjs",
    "test:async-state": "node scripts/test-latest-request-gate.mjs && node --experimental-strip-types --loader ./scripts/lib-alias-loader.mjs scripts/test-node-state-reconcile.mjs",
    "test:core-events": "node --experimental-strip-types scripts/test-core-event-lifecycle.mjs",
    "test:release-version": "node scripts/test-version-manifests.mjs && node scripts/test-release-policy.mjs",
    "test:app-update": "node --experimental-strip-types scripts/test-app-update-policy.mjs",
    "test:onboarding": "node --experimental-strip-types scripts/test-onboarding-state.mjs",
    "test:subscriptions": "node scripts/test-subscription-contract.mjs",
    "test:connections": "node --experimental-strip-types scripts/test-connection-delta-batcher.mjs && node --experimental-strip-types --loader ./scripts/lib-alias-loader.mjs scripts/test-connection-view.mjs && node --experimental-strip-types --loader ./scripts/lib-alias-loader.mjs scripts/test-connection-wire.mjs && node --experimental-strip-types --loader ./scripts/lib-alias-loader.mjs scripts/test-connection-history.mjs",
    "test:logs": "node --experimental-strip-types --loader ./scripts/lib-alias-loader.mjs scripts/test-log-page.mjs",
    "test:config-validation": "node --experimental-strip-types scripts/test-config-validation.mjs",
    "test:dns-config": "node --experimental-strip-types --loader ./scripts/lib-alias-loader.mjs scripts/test-dns-config.mjs",
    "test:kernel-settings": "node scripts/test-kernel-settings.mjs",
    "test:lite-session": "node scripts/test-lite-session-traffic.mjs",
    "test:cross-mode-state": "node scripts/test-cross-mode-state.mjs",
    "test:desktop-shell": "node --experimental-strip-types scripts/test-desktop-shell.mjs",
    "test:runtime-lifecycle": "node scripts/test-runtime-lifecycle.mjs",
    "verify:frontend": "pnpm test:nodes && pnpm test:notifications && pnpm test:diagnostic-copy && pnpm test:async-state && pnpm test:core-events && pnpm test:release-version && pnpm test:app-update && pnpm test:onboarding && pnpm test:subscriptions && pnpm test:connections && pnpm test:logs && pnpm test:config-validation && pnpm test:dns-config && pnpm test:kernel-settings && pnpm test:lite-session && pnpm test:cross-mode-state && pnpm test:runtime-lifecycle && pnpm test:desktop-shell && pnpm check && pnpm build",
    "verify:backend": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo check --manifest-path src-tauri/Cargo.toml --locked --all-targets -j 1 && cargo test --manifest-path src-tauri/Cargo.toml --locked -j 1",
    "verify": "pnpm verify:frontend && pnpm verify:backend && git diff --check",
    "verify:bundle": "pnpm verify && pnpm tauri build --no-sign",
    "verify:release": "pnpm verify && pnpm tauri build --ci",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "prepare": "husky",
    "commit": "git-cz",
    "lint:commit": "commitlint --edit",
    "test:nodes-probe-state": "node --experimental-strip-types --loader ./scripts/lib-alias-loader.mjs scripts/test-nodes-probe-state.mjs"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "author": "ZeroDenet <zerodenet.org>",
  "license": "MPL-2.0",
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "flag-icons": "7.5.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@internationalized/date": "^3.12.3",
    "@lucide/svelte": "^1.33.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^25.9.5",
    "autoprefixer": "^10.5.4",
    "bits-ui": "^2.19.0",
    "clsx": "^2.1.1",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "postcss": "^8.5.26",
    "shadcn-svelte": "^1.5.0",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.2.2"
  }
}
